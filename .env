# Telegram bot tokeni (@BotFather orqali oling)
TELEGRAM_TOKEN=

# /developer buyrug'iga faqat shu Telegram user_id'larga ruxsat beriladi
# (vergul bilan ajratib bir nechtasini yozish mumkin, masalan: 111,222)
ADMIN_IDS=

# ============================================================
# DOIMIY SAQLASH (/developer orqali qo'shilgan AI kalitlar, "Mening
# fayllarim" tarixi, statistika va eslatmalar QAYTA DEPLOY qilinganda
# YO'QOLMASLIGI uchun) — IKKI VARIANTDAN FAQAT BITTASINI sozlash kifoya.
# Hech biri sozlanmasa, hammasi MAHALLIY faylga yoziladi va Render kabi
# vaqtinchalik-disk hostinglarda har QAYTA DEPLOYDA o'chib ketadi!
# ============================================================

# --- 1-VARIANT: Neon (Postgres) — HAQIQIY database (tavsiya etiladi) ---
# https://neon.tech da bepul loyiha yarating (karta shart emas), "Connection
# string" ni nusxalab shu yerga qo'ying. Kerakli jadvalni kod o'zi yaratadi.
DATABASE_URL=

# --- 2-VARIANT: Upstash Redis (Neon o'rniga, bepul, tezroq) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- 3-VARIANT: GitHub repo'ga avtomatik commit (yuqoridagilar sozlanmasa) ---
# GitHub > Settings > Developer settings > Personal access tokens dan
# "Contents: Read and write" huquqiga ega token yarating:
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main

# ============================================================
# STANDART (UMUMIY) BEPUL KALITLAR
# Agar funksiyaga alohida kalit berilmasa, shu kalitlar ishlatiladi.
# ============================================================
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Botning ochiq (https://...) manzili (Render "Settings"da ko'rsatilgan
# URL, masalan https://talaba-ai.onrender.com — OXIRIDA "/" YO'Q). Faqat
# inline rejimda "og'ir" vazifalar (kurs ishi PDF) uchun kerak.
PUBLIC_BASE_URL=

# ============================================================
# HAR BIR FUNKSIYA UCHUN ALOHIDA AI (ixtiyoriy — bo'sh qoldirilsa standart
# qiymatlar ishlatiladi: provider=gemini, model=gemini-3.6-flash).
# Bu qiymatlar FAQAT BOSHLANG'ICH — keyinchalik /developer buyrug'i orqali
# botning o'zidan turib o'zgartirish TAVSIYA ETILADI (bu yerni tahrirlash
# shart emas).
# ============================================================

# 💬 Universal chat
UNIVERSAL_CHAT_PROVIDER=gemini
UNIVERSAL_CHAT_MODEL=gemini-3.6-flash
UNIVERSAL_CHAT_API_KEY=

# 📘 Kurs ishi / loyiha
COURSE_WORK_PROVIDER=gemini
COURSE_WORK_MODEL=gemini-3.6-flash
COURSE_WORK_API_KEY=

# 🌐 Tarjima qilish
TRANSLATE_PROVIDER=gemini
TRANSLATE_MODEL=gemini-3.6-flash
TRANSLATE_API_KEY=

# 📝 PDF ni tahrirlash
EDIT_PDF_PROVIDER=gemini
EDIT_PDF_MODEL=gemini-3.6-flash
EDIT_PDF_API_KEY=

# 📖 Qo'llanma tayyorlash
GUIDE_PROVIDER=gemini
GUIDE_MODEL=gemini-3.6-flash
GUIDE_API_KEY=

# 👁 Rasm tahlili (Vision, umumiy zaxira)
VISION_PROVIDER=gemini
VISION_MODEL=gemini-3.6-flash
VISION_API_KEY=

# 📊 Taqdimot (PPTX)
PPTX_PROVIDER=gemini
PPTX_MODEL=gemini-3.6-flash
PPTX_API_KEY=

# 📋 Test/Viktorina
QUIZ_PROVIDER=gemini
QUIZ_MODEL=gemini-3.6-flash
QUIZ_API_KEY=

# 🗒 Referat/Insho
ESSAY_PROVIDER=gemini
ESSAY_MODEL=gemini-3.6-flash
ESSAY_API_KEY=

# 📑 Konspekt qisqartirish
SUMMARY_PROVIDER=gemini
SUMMARY_MODEL=gemini-3.6-flash
SUMMARY_API_KEY=

# ✅ Imlo/Grammatika tekshirish
GRAMMAR_PROVIDER=gemini
GRAMMAR_MODEL=gemini-3.6-flash
GRAMMAR_API_KEY=

# 📚 Iqtibos generatori
CITATION_PROVIDER=gemini
CITATION_MODEL=gemini-3.6-flash
CITATION_API_KEY=

# 🧮 Masala yechish (rasm qabul qiladi — HAR DOIM Gemini bo'lishi kerak)
SOLVE_PROVIDER=gemini
SOLVE_MODEL=gemini-3.6-flash
SOLVE_API_KEY=

# 🎙 Ovozli xabar (audio qabul qiladi — HAR DOIM Gemini bo'lishi kerak)
VOICE_PROVIDER=gemini
VOICE_MODEL=gemini-3.6-flash
VOICE_API_KEY=

# Render "Free Web Service" health-check porti (Render avtomatik beradi, o'zgartirmang)
PORT=10000
