# Telegram bot tokeni (@BotFather orqali oling)
TELEGRAM_TOKEN=

# ============================================================
# STANDART (UMUMIY) BEPUL KALITLAR
# Agar funksiyaga alohida kalit berilmasa, shu kalitlar ishlatiladi.
# ============================================================
GEMINI_API_KEY=      # https://aistudio.google.com/apikey  (bepul)
GROQ_API_KEY=         # https://console.groq.com/keys       (bepul)

# ============================================================
# HAR BIR FUNKSIYA UCHUN ALOHIDA AI
# provider: gemini | groq
# Bo'sh qoldirilsa: provider=gemini, model=gemini-3.6-flash, kalit=GEMINI_API_KEY
# base_url faqat groq/openai-compatible provayderlar uchun (masalan boshqa
# bepul provayder qo'shmoqchi bo'lsangiz)
# ============================================================

# 馃挰 UNIVERSAL CHAT 鈥� barcha funksiyalarga murojat qila oladigan asosiy AI
UNIVERSAL_CHAT_PROVIDER=gemini
UNIVERSAL_CHAT_MODEL=gemini-3.6-flash
UNIVERSAL_CHAT_API_KEY=

# 馃摌 Kurs ishi / loyiha
COURSE_WORK_PROVIDER=gemini
COURSE_WORK_MODEL=gemini-3.6-flash
COURSE_WORK_API_KEY=

# 馃寪 Tarjima qilish
TRANSLATE_PROVIDER=gemini
TRANSLATE_MODEL=gemini-3.6-flash
TRANSLATE_API_KEY=

# 馃摑 PDF ni tahrirlash
EDIT_PDF_PROVIDER=gemini
EDIT_PDF_MODEL=gemini-3.6-flash
EDIT_PDF_API_KEY=

# 馃摉 Qo'llanma tayyorlash
GUIDE_PROVIDER=gemini
GUIDE_MODEL=gemini-3.6-flash
GUIDE_API_KEY=

# 馃柤 Rasm tahlili uchun zaxira (hozircha ishlatilmaydi, keyingi funksiyalar uchun)
VISION_PROVIDER=gemini
VISION_MODEL=gemini-3.6-flash
VISION_API_KEY=

# Render "Free Web Service" health-check porti (Render avtomatik beradi, o'zgartirmang)
PORT=10000